# =========================================================
# LUDOGAMIF · CONFIGURACIÓN PARA TU COMPUTADOR
# ---------------------------------------------------------
# Copia este archivo como .env:
#   Linux / Mac:  cp .env.local.ejemplo .env
#   Windows:      copy .env.local.ejemplo .env
# Luego: docker compose -f docker-compose.yml -f docker-compose.local.yml up -d --build
# y abre http://localhost:8082
# =========================================================

DOMINIO=localhost
PUERTO_APP=8082

POSTGRES_DB=ludogamif
POSTGRES_USER=ludogamif
POSTGRES_PASSWORD=clave_local_solo_para_pruebas

# Mínimo 32 caracteres.
JWT_SECRET=clave_local_solo_para_pruebas_cambiala_1234567890

CORS_ORIGINS=*
TRUST_PROXY=false
VITE_SERVER_URL=
