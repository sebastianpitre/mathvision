# =========================================================
# LUDOGAMIF · CONFIGURACIÓN DEL SERVIDOR
# ---------------------------------------------------------
# No lo copies a mano: "sudo ./ludogamif.sh instalar" crea el
# .env con claves nuevas y permisos 600. Este archivo es solo
# la guía de qué contiene. El .env NUNCA va a git.
# =========================================================

# Dirección pública del juego
DOMINIO=ludogamif.ocloudev.lat

# Puerto local donde queda el juego (solo 127.0.0.1).
# 8080 = catálogo, 8081 = POS.
PUERTO_APP=8082

# Base de datos (solo la ve la app, por la red interna de Docker)
POSTGRES_DB=ludogamif
POSTGRES_USER=ludogamif
POSTGRES_PASSWORD=SE_GENERA_AL_INSTALAR

# Firma de las sesiones. Si la cambias, todos deben volver a entrar.
JWT_SECRET=SE_GENERA_AL_INSTALAR

# Desde qué dominios se puede usar la API (el propio juego).
CORS_ORIGINS=https://ludogamif.ocloudev.lat

# Nginx y Cloudflare van delante: leer la IP real del jugador.
TRUST_PROXY=true

# Vacío = la API está en el mismo dominio del juego (lo normal).
VITE_SERVER_URL=
