{
  "name": "ludogamif-game-server",
  "version": "3.0.0",
  "description": "Servidor multijugador de LudoGamif (Express + Socket.IO + PostgreSQL)",
  "type": "module",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "migrar": "node scripts/migrar.js",
    "admin": "node scripts/admin.js",
    "check": "node scripts/check.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^18.0.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.10",
    "socket.io-client": "^4.8.3"
  },
  "nodemonConfig": {
    "watch": ["server.js", "src", ".env"],
    "ext": "js,json,env"
  }
}
